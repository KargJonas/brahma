# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
        separator = "    |    "
        # needed for the <span> around the battery %icon
        markup = "pango"
}

order += "volume"
# order += "blipper"
# order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
order += "claude_usage"
order += "battery all"
order += "disk /"
# order += "load"
# order += "cpu_temperature 0"
order += "memory"
order += "tztime local"

# blipper {
#     # format = "%quote"
#     # format = "%breathe"
#     # format = "%blip"
#     format = "%emoji"
#     n_emojis = 30
# }

volume master {
        format = "♪: %volume"
        format_muted = "♪: muted (%volume)"
        device = "pulse:alsa_output.pci-0000_00_1f.3.analog-stereo"
}

wireless _first_ {
        format_up = "W:%quality at %essid"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

# only available in this fork (~/code/i3status), see "man i3status"
claude_usage {
        format = "Claude %5h_left (%5h_reset_at) / %7d_left (%7d_reset_at) %stale"
}

battery all {
        format = "%status <span size='14pt' rise='-2500'> %icon </span> %percentage %remaining"
        low_threshold = 15
        threshold_type = percentage
}

disk "/" {
        prefix_type = "decimal"
        format = "%avail"
}

load {
        format = "%1min"
}

cpu_temperature 0 {
        format = "T: %degrees °C"
        path = "/sys/devices/platform/coretemp.0/temp1_input"
}

memory {
        format = "%used / %available"
        prefix_type = "decimal"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"

        # this option is only available in the KargJonas/i3status fork
        # print_units = "false"
}

tztime local {
        # format = "%d-%m-%Y %H:%M:%S"
        format = "%H:%M %A %d.%m "
}
